{
  "name": "@vcdit/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VC DIT desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "package:win": "electron-vite build && node scripts/package.mjs --win",
    "package:mac": "electron-vite build && node scripts/package.mjs --mac",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "productName": "VC DIT",
  "author": "VC DIT",
  "homepage": "https://vc-dit.com"
}
